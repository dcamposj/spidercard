                        </ImageView>
                        <ImageView id="img" fitHeight="329.0" fitWidth="437.0" onMouseClicked="#onMouseClicked4Palos" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../resources/iconos/4palos.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
                  <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="1280.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
